[TEMPLATE]
# Discord Bot Token - get from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Client ID - your application's client ID
CLIENT_ID=your-client-id-here

# Guild ID - the Discord server the bot operates in
GUILD_ID=

# Bot owner ID - your Discord user ID
OWNER_ID=your-discord-user-id-here

# HTTP API - the FreshWay website calls this to send Discord messages.
# The API only starts when BOT_API_SECRET is set. Requests must send it as
# the `x-bot-secret` header.
BOT_API_SECRET=your-api-secret-here
BOT_API_PORT=3001

# Supabase - used by notifications/presence to fetch session & staff data
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Channel IDs (create these channels in your server and paste the IDs)
FRESHWAY_CHANNEL_TRAININGS=
FRESHWAY_CHANNEL_LOGS=
FRESHWAY_CHANNEL_TIMETABLE=
FRESHWAY_CHANNEL_PUNISHMENT_LOGS=
FRESHWAY_CHANNEL_ANNOUNCEMENTS=

# Training Division channels - these default to the live guild channel IDs.
# Override them here only if you want a different channel.
FRESHWAY_CHANNEL_VERIFICATION=1525788502648950855
FRESHWAY_CHANNEL_VERIFICATION_REVIEWS=1525794994932154449
FRESHWAY_CHANNEL_VOTING=1525791566919110736
FRESHWAY_CHANNEL_MESSAGE_LOGS=1525794474846982275

# Role IDs
FRESHWAY_ROLE_TRAINER=
FRESHWAY_ROLE_STAFF=
FRESHWAY_ROLE_MANAGEMENT=
FRESHWAY_ROLE_DIRECTORY=
FRESHWAY_ROLE_TM=
FRESHWAY_ROLE_TRAINING_LEADERSHIP=

# Staff-case voting: auto-resolves when one side reaches this many votes
FRESHWAY_VOTE_THRESHOLD=5

# Optional - base URL of the FreshWay portal, used for the "View on Portal"
# button on the timetable message (e.g. https://freshway-training.vercel.app)
FRESHWAY_PORTAL_URL=

# Trello - sessions booked with /training-booking are also created as cards
# on the FreshWay Trello board (same as the website does). Without these,
# the booking still works, it just won't appear on Trello.
TRELLO_API_KEY=
TRELLO_TOKEN=
# Optional - board id; the sessions list id is fixed. Only needed if Trello
# requires idBoard for card creation on your account.
TRELLO_BOARD_ID=
